# Все ключи опциональны: без них сервис работает (поиск, скоринг, сравнение, воронка, агент на правилах, извлечение regex).
OPENROUTER_API_KEY=          # https://openrouter.ai/keys — LLM-извлечение с сайтов, агент, письма КП
OPENROUTER_MODELS=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
DADATA_API_KEY=              # https://dadata.ru/profile/#info — реестр юрлиц РФ/РК, бесплатно до 10 000 запросов/сутки
YANDEX_GEOSEARCH_KEY=        # developer.tech.yandex.ru — «API Поиска по организациям»
YANDEX_GEOSEARCH_SECRET=     # секрет подписи запросов (если в кабинете включена «Подпись запросов»)
YANDEX_MAPS_JS_KEY=          # developer.tech.yandex.ru — «JavaScript API и HTTP Геокодер» (карта)
CHECKO_API_KEY=              # https://checko.ru/integration/api — финансы, суды, ФССП (РФ), бесплатно 100 запросов/сутки
